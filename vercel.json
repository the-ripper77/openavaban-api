{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/api/index.py"
    },
    {
      "src": "/bulk",
      "dest": "/api/bulk.py"
    },
    {
      "src": "/docs",
      "dest": "/api/docs.py"
    },
    {
      "src": "/docs/(.*)",
      "dest": "/api/docs.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ]
}
